{
  "name": "chat-adapter-telnyx",
  "version": "0.1.2",
  "description": "Community Telnyx adapter for Chat SDK — SMS and MMS bots with the Messaging API and Ed25519-signed webhooks",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/washedguy/chat-adapter-telnyx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/washedguy/chat-adapter-telnyx.git"
  },
  "bugs": {
    "url": "https://github.com/washedguy/chat-adapter-telnyx/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    }
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.41.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chat-adapter/state-memory": "^4.41.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "chat": "^4.41.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "community-adapter",
    "telnyx",
    "sms",
    "mms",
    "bot",
    "messaging"
  ],
  "license": "MIT"
}
